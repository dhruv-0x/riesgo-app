# ─── Servidor ───────────────────────────────────────────────
PORT=3000

# ─── Correo de envío (SMTP) ──────────────────────────────────
# Para Gmail: activa "Contraseñas de aplicación" en tu cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion

# ─── Correo destino de reportes ──────────────────────────────
# Cada formulario enviado llega aquí automáticamente
DEST_EMAIL=riesgos@tucolegio.edu.co

# ─── Admins autorizados para descargar datos ─────────────────
# Lista separada por comas. Solo estos correos pueden entrar al panel.
ADMIN_EMAILS=admin@tucolegio.edu.co,rector@tucolegio.edu.co

# ─── JWT Secret (cámbialo por algo largo y aleatorio) ────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_32chars

# ─── Nombre del colegio (aparece en correos y UI) ────────────
SCHOOL_NAME=Colegio San José
